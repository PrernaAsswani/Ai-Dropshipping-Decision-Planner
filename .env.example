# ========================================
# BACKEND ENVIRONMENT VARIABLES (Node/Express)
# ========================================

# MongoDB connection string (Leave blank locally to use in-memory DB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/decision_intel?retryWrites=true&w=majority"

# Port for the Node.js Server
PORT=8080

# The URL of your Frontend (Used for CORS security)
# Local: http://localhost:3000
# Production: https://your-netlify-app.netlify.app
APP_URL="http://localhost:3000"

# ========================================
# FRONTEND ENVIRONMENT VARIABLES (Vite/React)
# ========================================

# The URL of your Backend API
# Local: http://localhost:8080/api
# Production: https://decision-planner-api.onrender.com/api
VITE_API_URL="http://localhost:8080/api"
